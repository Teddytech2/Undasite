# Required for AI generation. Get an API key from your chosen provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: enable server-side Vercel deployment integration.
# Create a Vercel integration/token with least privilege.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional: Deriv links/settings defaults. Creators should configure their own values
# in the app settings; never put user access tokens here.
NEXT_PUBLIC_DERIV_LANDING_URL=https://deriv.com/
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase integration (not wired into this starter yet).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional storage provider for production bot uploads (not wired into this starter yet).
# Prefer S3-compatible object storage; never use a public executable web root.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
